---
import Base from "../layouts/Base.astro";
---

<Base title="HackFinder - Find Hackathons Worldwide" description="Find hackathons from Devpost, MLH, HackerEarth, DoraHacks and more. Search, filter, and find your next opportunity to build something great.">

  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950/50 via-gray-950 to-blue-950/30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Find Your Next
        <span class="bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">Hackathon</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">
        Find hackathons from Devpost, MLH, HackerEarth, DoraHacks and more &mdash; all in one place.
        Search, filter, and never miss an opportunity to build something great.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href="/hackathons"
          class="inline-flex items-center justify-center rounded-xl bg-cyan-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-cyan-500/25 hover:bg-cyan-400 transition-all hover:shadow-cyan-500/40"
        >
          Find Hackathons
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <span class="text-sm text-gray-400">Updated hourly from multiple sources</span>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="border-y border-gray-800 bg-gray-900/50" aria-labelledby="stats-heading">
    <h2 id="stats-heading" class="sr-only">Platform statistics</h2>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <dl class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-400">Hackathons Tracked</dt>
          <dd class="mt-2 text-3xl font-bold tracking-tight text-white">1,000+</dd>
        </div>
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-400">Data Sources</dt>
          <dd class="mt-2 text-3xl font-bold tracking-tight text-white">4</dd>
        </div>
        <div class="text-center">
          <dt class="text-sm font-medium text-gray-400">Refresh Frequency</dt>
          <dd class="mt-2 text-3xl font-bold tracking-tight text-white">Every Hour</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="how-it-works-heading">
    <div class="text-center">
      <h2 id="how-it-works-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        How It Works
      </h2>
      <p class="mt-3 text-gray-400">Three simple steps to find your next hackathon</p>
    </div>

    <ol class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3" role="list">
      <!-- Step 1 -->
      <li class="relative flex flex-col items-center text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-cyan-500/20 ring-1 ring-cyan-500/30">
          <svg class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-white">Aggregated Sources</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-400">
          We automatically collect hackathon data from Devpost, MLH, HackerEarth, and more every hour.
        </p>
      </li>

      <!-- Step 2 -->
      <li class="relative flex flex-col items-center text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-cyan-500/20 ring-1 ring-cyan-500/30">
          <svg class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-white">Search & Filter</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-400">
          Quickly find relevant events with full-text search, date filters, format options, and tag-based browsing.
        </p>
      </li>

      <!-- Step 3 -->
      <li class="relative flex flex-col items-center text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-cyan-500/20 ring-1 ring-cyan-500/30">
          <svg class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-white">Discover Events</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-400">
          View full details, check deadlines, and jump straight to registration on the original event page.
        </p>
      </li>
    </ol>
  </section>

  <!-- Featured Sources Section -->
  <section class="border-t border-gray-800 bg-gray-900/30" aria-labelledby="sources-heading">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 id="sources-heading" class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Featured Sources
      </h2>
      <p class="mt-3 text-center text-gray-400">Data aggregated from the top hackathon platforms</p>

      <ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        <!-- Devpost -->
        <li class="flex flex-col items-center rounded-xl border border-gray-800 bg-gray-900/50 p-8 transition-colors hover:border-cyan-500/50 hover:bg-gray-900">
          <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-blue-600/20">
            <svg class="h-8 w-8 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-white">Devpost</h3>
          <p class="mt-2 text-center text-sm text-gray-400">
            The world's largest hackathon platform with thousands of events and millions in prizes.
          </p>
        </li>

        <!-- MLH -->
        <li class="flex flex-col items-center rounded-xl border border-gray-800 bg-gray-900/50 p-8 transition-colors hover:border-cyan-500/50 hover:bg-gray-900">
          <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-red-600/20">
            <svg class="h-8 w-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-white">MLH</h3>
          <p class="mt-2 text-center text-sm text-gray-400">
            Major League Hacking &mdash; the official student hackathon league with seasonal events worldwide.
          </p>
        </li>

        <!-- HackerEarth -->
        <li class="flex flex-col items-center rounded-xl border border-gray-800 bg-gray-900/50 p-8 transition-colors hover:border-cyan-500/50 hover:bg-gray-900">
          <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-green-600/20">
            <svg class="h-8 w-8 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-white">HackerEarth</h3>
          <p class="mt-2 text-center text-sm text-gray-400">
            Developer challenges and hackathons from one of the leading competitive programming platforms.
          </p>
        </li>

        <!-- DoraHacks -->
        <li class="flex flex-col items-center rounded-xl border border-gray-800 bg-gray-900/50 p-8 transition-colors hover:border-cyan-500/50 hover:bg-gray-900">
          <div class="flex h-16 w-16 items-center justify-center rounded-lg bg-purple-600/20">
            <svg class="h-8 w-8 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-white">DoraHacks</h3>
          <p class="mt-2 text-center text-sm text-gray-400">
            Web3 and frontier tech hackathons with large prize pools, often exceeding $100k in crypto and funding.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-gray-800 bg-gradient-to-br from-slate-950/40 to-blue-950/40 p-10 text-center sm:p-16">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Ready to find your next hackathon?
      </h2>
      <p class="mt-4 text-gray-400">
        Browse the full listing with powerful search and filters.
      </p>
      <a
        href="/hackathons"
        class="mt-8 inline-flex items-center justify-center rounded-xl bg-cyan-500 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-cyan-500/25 hover:bg-cyan-400 transition-all hover:shadow-cyan-500/40"
      >
        Find Hackathons
        <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>

</Base>
