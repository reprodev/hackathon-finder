---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hackathon Discovery Platform</title>
    <meta name="description" content="Discover hackathons from multiple sources - Devpost, MLH, HackerEarth and more." />
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <main class="max-w-7xl mx-auto px-4 py-8">
      <h1 class="text-4xl font-bold">Hackathon Discovery Platform</h1>
      <p class="mt-4 text-lg text-gray-600">Find your next hackathon from multiple sources.</p>
    </main>
  </body>
</html>
