---
import Base from "../layouts/Base.astro";
---

<Base title="HackathonHub - Discover Hackathons Worldwide">
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      Discover Your Next
      <span class="text-indigo-400">Hackathon</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-gray-400">
      Find hackathons from Devpost, MLH, HackerEarth and more — all in one place.
      Search, filter, and never miss an opportunity to build something great.
    </p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <a
        href="/hackathons"
        class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors"
      >
        Browse Hackathons
      </a>
    </div>
  </section>
</Base>
