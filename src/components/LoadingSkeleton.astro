---
interface Props {
  count?: number;
}

const { count = 6 } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  {Array.from({ length: count }).map(() => (
    <div class="animate-pulse rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      {/* Title placeholder */}
      <div class="h-5 w-4/5 rounded bg-gray-300 mb-3"></div>

      {/* Date placeholder */}
      <div class="flex items-center gap-2 mb-4">
        <div class="h-4 w-16 rounded bg-gray-300"></div>
        <div class="h-4 w-3 rounded bg-gray-200"></div>
        <div class="h-4 w-16 rounded bg-gray-300"></div>
      </div>

      {/* Tags placeholder */}
      <div class="flex gap-2 mb-4">
        <div class="h-6 w-14 rounded-full bg-gray-200"></div>
        <div class="h-6 w-14 rounded-full bg-gray-200"></div>
        <div class="h-6 w-14 rounded-full bg-gray-200"></div>
      </div>

      {/* Organizer placeholder */}
      <div class="h-4 w-1/3 rounded bg-gray-300 mb-4"></div>

      {/* Format badge placeholder */}
      <div class="h-7 w-24 rounded bg-gray-200"></div>
    </div>
  ))}
</div>
