---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found - HackFinder">
  <section class="mx-auto flex max-w-7xl flex-col items-center justify-center px-4 py-32 sm:px-6 lg:px-8">
    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-cyan-500/20 ring-1 ring-cyan-500/30">
      <svg class="h-10 w-10 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>

    <h1 class="mt-8 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Page Not Found
    </h1>

    <p class="mt-4 max-w-md text-center text-lg text-gray-400">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-lg bg-cyan-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-500/25 hover:bg-cyan-400 transition-all hover:shadow-cyan-500/40"
      >
        Go Home
      </a>
      <a
        href="/hackathons"
        class="inline-flex items-center justify-center rounded-lg border border-gray-700 px-6 py-3 text-sm font-semibold text-gray-300 hover:border-gray-600 hover:text-white transition-colors"
      >
        Browse Hackathons
      </a>
    </div>
  </section>
</Base>
