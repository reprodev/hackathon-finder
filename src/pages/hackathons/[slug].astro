---
import Base from "../../layouts/Base.astro";
import { getHackathonBySlug } from "../../lib/db/queries";
import type { Format } from "../../lib/types";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/hackathons");
}

const db = Astro.locals.runtime.env.DB;
const hackathon = await getHackathonBySlug(db, slug);

if (!hackathon) {
  Astro.response.status = 404;
}

// Helpers
function formatDateRange(startDate: string, endDate: string | null): string {
  const start = new Date(startDate);
  const full: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric', year: 'numeric' };
  const monthDay: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric' };

  if (!endDate) {
    return start.toLocaleDateString('en-US', full);
  }

  const end = new Date(endDate);
  const sameYear = start.getFullYear() === end.getFullYear();
  const sameDay = sameYear && start.getMonth() === end.getMonth() && start.getDate() === end.getDate();

  if (sameDay) {
    return start.toLocaleDateString('en-US', full);
  }

  if (sameYear) {
    return `${start.toLocaleDateString('en-US', monthDay)} - ${end.toLocaleDateString('en-US', full)}`;
  }

  return `${start.toLocaleDateString('en-US', full)} - ${end.toLocaleDateString('en-US', full)}`;
}

function getFormatLabel(format: Format): string {
  switch (format) {
    case 'virtual': return 'Virtual';
    case 'in_person': return 'In Person';
    case 'hybrid': return 'Hybrid';
  }
}

function getFormatClasses(format: Format): string {
  switch (format) {
    case 'virtual': return 'bg-green-900/60 text-green-300 border-green-700';
    case 'in_person': return 'bg-blue-900/60 text-blue-300 border-blue-700';
    case 'hybrid': return 'bg-purple-900/60 text-purple-300 border-purple-700';
  }
}

const canonicalUrl = new URL(`/hackathons/${slug}`, Astro.site || Astro.url.origin).href;
const pageTitle = hackathon ? `${hackathon.title} - HackathonHub` : "Hackathon Not Found - HackathonHub";
const pageDescription = hackathon?.description
  ? hackathon.description.slice(0, 160)
  : "Hackathon details on HackathonHub";
---

<Base title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    {hackathon && (
      <>
        <meta property="og:title" content={hackathon.title} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={hackathon.title} />
      </>
    )}
  </Fragment>

  {hackathon ? (
    <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
      {/* Breadcrumb navigation */}
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-400" role="list">
          <li>
            <a href="/" class="hover:text-indigo-400 transition-colors">Home</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li>
            <a href="/hackathons" class="hover:text-indigo-400 transition-colors">Browse</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-gray-200 truncate max-w-[200px]" aria-current="page">
            {hackathon.title}
          </li>
        </ol>
      </nav>

      {/* Header */}
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class={`inline-block rounded-full border px-3 py-1 text-xs font-medium ${getFormatClasses(hackathon.format)}`}>
            {getFormatLabel(hackathon.format)}
          </span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {hackathon.title}
        </h1>
      </header>

      {/* Key info grid */}
      <div class="grid gap-4 sm:grid-cols-2 mb-8">
        {/* Dates */}
        <div class="rounded-lg border border-gray-700 bg-gray-800 p-4">
          <div class="flex items-center gap-2 text-sm font-medium text-gray-400 mb-1">
            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Dates
          </div>
          <p class="text-gray-100">{formatDateRange(hackathon.startDate, hackathon.endDate)}</p>
        </div>

        {/* Location */}
        <div class="rounded-lg border border-gray-700 bg-gray-800 p-4">
          <div class="flex items-center gap-2 text-sm font-medium text-gray-400 mb-1">
            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Location
          </div>
          <p class="text-gray-100">
            {hackathon.location ? hackathon.location : (hackathon.format === 'virtual' ? 'Online' : 'TBA')}
          </p>
        </div>

        {/* Organizer */}
        {hackathon.organizer && (
          <div class="rounded-lg border border-gray-700 bg-gray-800 p-4">
            <div class="flex items-center gap-2 text-sm font-medium text-gray-400 mb-1">
              <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Organizer
            </div>
            <p class="text-gray-100">{hackathon.organizer}</p>
          </div>
        )}

        {/* Prizes */}
        {hackathon.prizes && (
          <div class="rounded-lg border border-gray-700 bg-gray-800 p-4">
            <div class="flex items-center gap-2 text-sm font-medium text-gray-400 mb-1">
              <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Prizes
            </div>
            <p class="text-gray-100">{hackathon.prizes}</p>
          </div>
        )}
      </div>

      {/* Description */}
      {hackathon.description && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-gray-100 mb-3">About this Hackathon</h2>
          <div class="prose prose-invert max-w-none">
            <p class="text-gray-300 leading-relaxed whitespace-pre-wrap">{hackathon.description}</p>
          </div>
        </section>
      )}

      {/* Tags */}
      {hackathon.tags.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-gray-100 mb-3">Tags</h2>
          <div class="flex flex-wrap gap-2">
            {hackathon.tags.map((tag) => (
              <span class="rounded-md border border-gray-600 bg-gray-700 px-3 py-1 text-sm text-gray-200">
                {tag}
              </span>
            ))}
          </div>
        </section>
      )}

      {/* Source link */}
      <section class="mt-10 pt-6 border-t border-gray-700">
        {hackathon.sourceUrl ? (
          <a
            href={hackathon.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors"
          >
            Visit Original Event
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ) : (
          <p class="text-sm text-gray-500 italic">
            The original event page is not available.
          </p>
        )}
      </section>
    </article>
  ) : (
    <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl font-bold text-white mb-4">Hackathon Not Found</h1>
      <p class="text-gray-400 mb-8">
        The hackathon you're looking for doesn't exist or is no longer available.
      </p>
      <a
        href="/hackathons"
        class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors"
      >
        Browse Hackathons
      </a>
    </div>
  )}
</Base>